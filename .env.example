# Database Configuration
DATABASE_URL=postgresql://taska_user:taska_password@localhost:5432/taska_dev
POSTGRES_USER=taska_user
POSTGRES_PASSWORD=taska_password
POSTGRES_DB=taska_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your-super-secure-refresh-token-secret
REFRESH_TOKEN_EXPIRATION=7d

# API Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:3001

# File Storage (MinIO/S3)
S3_BUCKET=taska-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=taska-admin
S3_SECRET_KEY=taska-password
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Email Configuration (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@taska.co.za

# SendGrid (Production Email)
SENDGRID_API_KEY=your-sendgrid-api-key

# Payment Integration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayFast (South African Payment Gateway)
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase
PAYFAST_SANDBOX=true

# SMS Configuration (for OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Security Hardening (Phase 17)
MESSAGE_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
DATABASE_ENCRYPTION_KEY=your-32-byte-hex-database-encryption-key
CSRF_SECRET=your-csrf-secret-key-here
SECURITY_WEBHOOK_URL=https://your-webhook-url-for-security-alerts
PERFORMANCE_WEBHOOK_URL=https://your-webhook-url-for-performance-alerts
ALLOWED_ORIGINS=http://localhost:3000,https://taska.co.za,https://www.taska.co.za

# Monitoring & Logging
LOG_LEVEL=debug
SENTRY_DSN=your_sentry_dsn

# MCP Configuration
CONTEXT7_API_KEY=your_context7_api_key
MCP_GIT_PATH=/path/to/git/repo
MCP_DB_CONNECTION=postgresql://taska_user:taska_password@localhost:5432/taska_dev

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# File Upload Limits
MAX_FILE_SIZE=5242880
MAX_FILES_PER_UPLOAD=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Session Configuration
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=86400000

# Geocoding Service
OPENCAGE_API_KEY=your_opencage_api_key

# Push Notifications
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id

# Feature Flags
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SMS_VERIFICATION=true
ENABLE_PAYMENT_PROCESSING=true
ENABLE_REAL_TIME_CHAT=true
ENABLE_PUSH_NOTIFICATIONS=true
