# ============================================
# Taska Platform - Production Environment
# ============================================
# Copy this file to .env.production and fill in your values
# NEVER commit .env.production to git!

# ============================================
# Database Configuration
# ============================================
# Get from: terraform output database_endpoint
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://taska_admin:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT:5432/taska

# PostgreSQL Direct Connection (if needed)
POSTGRES_HOST=YOUR_RDS_ENDPOINT
POSTGRES_PORT=5432
POSTGRES_DB=taska
POSTGRES_USER=taska_admin
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# ============================================
# Redis Configuration
# ============================================
# Get from: terraform output redis_endpoint
REDIS_HOST=YOUR_REDIS_ENDPOINT
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY

# S3 Bucket for uploads
# Get from: terraform output s3_bucket_name
S3_BUCKET=YOUR_S3_BUCKET_NAME

# ============================================
# Security & Authentication
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=YOUR_64_CHAR_RANDOM_STRING

# Session secret
SESSION_SECRET=YOUR_SESSION_SECRET

# ============================================
# Email Configuration (SendGrid)
# ============================================
# Sign up at: https://sendgrid.com
# Get API key from: Settings > API Keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@your-domain.com
SENDGRID_FROM_NAME=Taska Platform

# ============================================
# Payment Gateway - Stripe
# ============================================
# Sign up at: https://stripe.com
# Get keys from: Developers > API keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Public key (safe to expose in frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# ============================================
# Payment Gateway - PayFast (South Africa)
# ============================================
# Sign up at: https://www.payfast.co.za
# Get credentials from: Settings > Integration
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_MODE=live

# Public merchant ID (safe to expose in frontend)
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=your_merchant_id

# ============================================
# Monitoring & Error Tracking (Sentry)
# ============================================
# Optional but recommended
# Sign up at: https://sentry.io
# Create new project and get DSN
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ============================================
# Application URLs
# ============================================
# Backend API URL
API_URL=https://api.your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# WebSocket URL
WEBSOCKET_URL=wss://api.your-domain.com
NEXT_PUBLIC_WEBSOCKET_URL=wss://api.your-domain.com

# Frontend URL
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_FRONTEND_URL=https://your-domain.com

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=3000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Feature Flags
# ============================================
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SMS_NOTIFICATIONS=false

# ============================================
# Analytics (Optional)
# ============================================
# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=your_pixel_id

# ============================================
# SMS Service (Optional - for notifications)
# ============================================
# If using Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+27XXXXXXXXX

# ============================================
# Grafana & Monitoring
# ============================================
GRAFANA_PASSWORD=your_secure_grafana_password

# ============================================
# Notes
# ============================================
# 1. Generate secure random strings for secrets
# 2. Never share or commit this file
# 3. Keep backup in secure location (password manager)
# 4. Rotate secrets regularly
# 5. Use AWS Secrets Manager for extra security
